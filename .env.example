# Copy to .env locally and fill in values. Never commit real credentials.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/music
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me

# Required: use a long, random secret appropriate for your JWT implementation.
ACCESS_JWT_KEY=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Redis container in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Music backend base URL; Cloud Run URL must not include :8080.
MUSIC_SERVICE_URL=https://music-service-210534030028.asia-southeast1.run.app

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Safer default for production; schema changes should be Liquibase-managed.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
LIQUIBASE_ENABLED=true
PORT=8181
