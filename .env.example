# Copy to .env locally and fill in values. Never commit real credentials.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/music
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me

# Required: use a long, random secret appropriate for your JWT implementation.
ACCESS_JWT_KEY=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Local docker-compose Redis service.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_DATABASE=0

# Production: set REDIS_HOST to the reachable hostname/IP of a managed/external Redis instance.
# Set REDIS_PASSWORD if required and REDIS_SSL_ENABLED=true if that provider requires TLS.

MUSIC_SERVICE_URL=https://music-service-210534030028.asia-southeast1.run.app

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
LIQUIBASE_ENABLED=true
PORT=8181

# Comma-separated origins, e.g. https://music.example.com,https://admin.music.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
